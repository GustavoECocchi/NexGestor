# NexGestor — Configuração do deploy no VPS.
#
# Copie este arquivo para `.env` (no VPS) e preencha os valores:
#     cp .env.example .env
#     nano .env
#
# ⚠️ REGRA DE SEGREDO: a GEMINI_API_KEY é preenchida DIRETO NO VPS (nano/editor),
#    nunca digitada/colada num chat. O `.env` fica só no servidor e está no
#    .gitignore — não sobe pro GitHub.

# ── Domínio ──────────────────────────────────────────────
# ⚠️ Usado APENAS pelo docker-compose.caddy.yml (servidor sem proxy próprio).
# Na montagem atual quem cuida do domínio e do certificado é o nginx do VPS,
# então esta linha é ignorada — pode deixar como está.
DOMAIN=gestor.nexgold.com.br

# ── Persistência das campanhas (SQLite) ──────────────────
# ⚠️ BASE COMPARTILHADA — decisão TEMPORÁRIA do período de testes: sem login e
# sem dono, toda a equipe vê e apaga as mesmas campanhas. Vira dado por pessoa
# antes do lançamento (ver app/service/storage.py).
#
# O docker-compose.yml já define isto apontando para o volume `nexgestor-dados`;
# a linha aqui existe para quem NÃO usa Docker. Deixar VAZIO desliga a
# persistência e o backend volta a ser stateless — a extensão continua
# funcionando, só guardando tudo no navegador de cada um.
DB_PATH=/dados/nexgestor.db
# Tetos defensivos (a API é pública e sem autenticação).
DB_MAX_CAMPANHAS=500
DB_MAX_PAYLOAD_BYTES=65536

# ── App ──────────────────────────────────────────────────
APP_NAME=NexGestor
DEBUG=False

# ── IA (Gemini) — LIGADA, chave compartilhada pela equipe ─
# Cole a chave no VPS (ver regra de segredo acima). Limite de R$15 na key:
# a equipe toda divide esse limite, então é normal.
#
# GEMINI_API_KEY VAZIA = IA DESLIGADA, SEM ERRO E SEM AVISO. A análise
# continua respondendo 200, só que com "ai_insights": null. É assim que o
# servidor está hoje (14/08/2026). Preencher esta linha é o único passo
# necessário para ligar a IA — o SDK já vem no requirements.txt e o modelo
# abaixo foi testado ao vivo em 14/08/2026 (resposta em ~2,8s).
GEMINI_API_KEY=
# Não trocar sem testar: modelos do Google são aposentados sem aviso, e os
# antigos (gemini-2.5-flash, gemini-flash-latest) já retornam 404 ou estouram
# o timeout de 8s abaixo.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_ENABLED=True
GEMINI_TIMEOUT_SECONDS=8.0

# ── CORS ─────────────────────────────────────────────────
# Não precisa mexer: o backend já aceita qualquer origem chrome-extension://
# por padrão (CORS_ORIGIN_REGEX no config.py). A extensão da equipe funciona
# sem configurar nada aqui.
